# Copy to .env.local. Only API_BASE_URL is server-side; NEXT_PUBLIC_* values are public client config, not secrets.
API_BASE_URL=http://localhost:8080
# Employee mobile sign-in (Firebase web config of the project in FIREBASE_PROJECT_ID). Leave empty to hide it.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Vendor console Google sign-in (same OAuth client as VENDOR_GOOGLE_CLIENT_ID on the API).
NEXT_PUBLIC_VENDOR_GOOGLE_CLIENT_ID=
